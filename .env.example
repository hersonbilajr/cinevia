# ---------------------------------------------------------------------------
# CINEVIA — variáveis de ambiente
# Copiar este ficheiro para ".env" e preencher com os dados da conta TMDB.
#
# Sem chave configurada a aplicação arranca em MODO DEMONSTRAÇÃO, com um
# catálogo local de filmes, para que o projecto possa ser avaliado de imediato.
# ---------------------------------------------------------------------------

# Opção recomendada (TMDB → Settings → API → "API Read Access Token",
# também designado token de leitura v4). Não tem prazo de validade.
VITE_TMDB_TOKEN=

# Alternativa: chave de API v3 (32 caracteres), também em Settings → API.
# Se ambas estiverem definidas, o token tem prioridade.
VITE_TMDB_API_KEY=

# Idioma dos títulos, sinopses e géneros devolvidos pela API.
VITE_TMDB_LANGUAGE=pt-PT

# (Opcional) caminho base do build. Ex.: /cinevia/
VITE_BASE=
